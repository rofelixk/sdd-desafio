{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saida.schema.json",
  "title": "Resultado do motor de reembolso",
  "description": "Formaliza a seção 4 da spec (v2.2). Em caso de divergência, a spec prevalece.",
  "type": "object",
  "required": ["colaborador", "periodo", "politica", "itens", "resumo"],
  "additionalProperties": false,
  "properties": {
    "colaborador": { "type": "object", "description": "Eco do objeto de entrada" },
    "periodo": { "type": "object", "description": "Eco do objeto de entrada" },
    "politica": {
      "type": "object",
      "required": ["versao", "tabela"],
      "additionalProperties": false,
      "properties": {
        "versao": { "type": "string", "minLength": 1, "description": "versao da tabela de limites usada" },
        "tabela": { "type": "string", "minLength": 1, "description": "\"padrao\" ou o centro de custo como está na tabela (RN-016)" }
      }
    },
    "itens": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "resumo": { "$ref": "#/$defs/resumo" }
  },
  "$defs": {
    "dinheiro": {
      "type": "number",
      "multipleOf": 0.01,
      "description": "Valor com no máximo duas casas decimais"
    },
    "dinheiroNaoNegativo": { "allOf": [{ "$ref": "#/$defs/dinheiro" }, { "minimum": 0 }] },
    "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "item": {
      "type": "object",
      "required": [
        "id", "data", "categoria", "moeda", "valor_original", "taxa_cambio", "data_cotacao",
        "valor_solicitado", "valor_reembolsavel", "status", "limite_diario_aplicado", "em_viagem",
        "diarias", "motivo"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "description": "Como veio; qualquer tipo em DADO_INVALIDO (AMB-023)" },
        "data": { "description": "Como veio; qualquer tipo em DADO_INVALIDO (AMB-023)" },
        "categoria": { "description": "Normalizada (RN-002) ou como veio (AMB-023)" },
        "moeda": { "description": "Normalizada (\"BRL\" se ausente); como veio em DADO_INVALIDO, ausente → null (RN-003)" },
        "valor_original": {
          "oneOf": [{ "$ref": "#/$defs/dinheiro" }, { "type": "null" }],
          "description": "Na moeda da despesa (RN-001). Nulo se valor ausente ou não numérico"
        },
        "taxa_cambio": {
          "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }],
          "description": "Como está no arquivo de câmbio; 1 em BRL. Nulo sem conversão (AMB-043)"
        },
        "data_cotacao": {
          "oneOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }],
          "description": "Nulo em BRL ou sem conversão (RN-017, AMB-043)"
        },
        "valor_solicitado": {
          "oneOf": [{ "$ref": "#/$defs/dinheiro" }, { "type": "null" }],
          "description": "Em reais. Nulo sem conversão: valor inválido ou sem cotação (AMB-023, AMB-043)"
        },
        "valor_reembolsavel": { "$ref": "#/$defs/dinheiroNaoNegativo" },
        "status": { "enum": ["APROVADO", "PARCIAL", "RECUSADO", "PENDENTE"] },
        "limite_diario_aplicado": {
          "oneOf": [{ "$ref": "#/$defs/dinheiroNaoNegativo" }, { "type": "null" }]
        },
        "em_viagem": { "type": ["boolean", "null"] },
        "diarias": { "type": ["integer", "null"], "minimum": 1 },
        "motivo": {
          "type": "object",
          "required": ["codigo", "descricao"],
          "additionalProperties": false,
          "properties": {
            "codigo": {
              "enum": [
                "APROVADO_INTEGRAL", "LIMITE_DIARIO_EXCEDIDO", "LIMITE_DIARIO_ESGOTADO",
                "DADO_INVALIDO", "VALOR_NAO_POSITIVO", "FORA_DO_PERIODO",
                "CATEGORIA_NAO_REEMBOLSAVEL", "CAMBIO_INDISPONIVEL", "DUPLICATA",
                "NOTA_FISCAL_AUSENTE", "REQUER_APROVACAO"
              ]
            },
            "descricao": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "description": "AMB-043: os três campos de conversão andam juntos",
          "if": { "properties": { "valor_solicitado": { "type": "null" } } },
          "then": { "properties": { "taxa_cambio": { "type": "null" }, "data_cotacao": { "type": "null" } } }
        },
        {
          "description": "Seção 4: PENDENTE ⇔ REQUER_APROVACAO",
          "if": { "properties": { "status": { "const": "PENDENTE" } } },
          "then": { "properties": { "motivo": { "properties": { "codigo": { "const": "REQUER_APROVACAO" } } } } },
          "else": { "properties": { "motivo": { "properties": { "codigo": { "not": { "const": "REQUER_APROVACAO" } } } } } }
        }
      ]
    },
    "resumo": {
      "type": "object",
      "required": [
        "quantidade_itens", "aprovados", "parciais", "recusados", "pendentes",
        "total_solicitado", "total_reembolsavel", "total_pendente", "total_nao_reembolsado"
      ],
      "additionalProperties": false,
      "properties": {
        "quantidade_itens": { "type": "integer", "minimum": 0 },
        "aprovados": { "type": "integer", "minimum": 0 },
        "parciais": { "type": "integer", "minimum": 0 },
        "recusados": { "type": "integer", "minimum": 0 },
        "pendentes": { "type": "integer", "minimum": 0 },
        "total_solicitado": { "$ref": "#/$defs/dinheiroNaoNegativo" },
        "total_reembolsavel": { "$ref": "#/$defs/dinheiroNaoNegativo" },
        "total_pendente": { "$ref": "#/$defs/dinheiroNaoNegativo" },
        "total_nao_reembolsado": { "$ref": "#/$defs/dinheiroNaoNegativo" }
      }
    }
  }
}
